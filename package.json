{
  "name": "foodrecommend",
  "version": "1.0.0",
  "description": "An AI food division Platform to help Users decide where, what to eat, how to order.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:all": "npm test -- --runInBand && npm run test:flutter && npm run analyze:flutter",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:prepare": "node scripts/prepare-integration-data.js",
    "test:flutter": "node scripts/run-flutter-tests.js test",
    "analyze:flutter": "node scripts/run-flutter-tests.js analyze",
    "build": "tsc",
    "lint": "eslint src tests",
    "db:init": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:make": "knex migrate:make",
    "seed": "psql -h localhost -U postgres -d food_recommend_db -f seed.sql",
    "start": "npx tsx src/index.ts",
    "dev": "npx tsx src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingi16525/foodrecommend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mingi16525/foodrecommend/issues"
  },
  "homepage": "https://github.com/mingi16525/foodrecommend#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "@types/socket.io": "^3.0.1",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "knex": "^3.3.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
